<ui:FluentWindow x:Class="CampusNet.Dialer.FirstRunWizard"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="首次设置向导"
                 Width="580" Height="560"
                 MinHeight="520" MinWidth="540"
                 WindowCornerPreference="Round"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="False"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="28,24,28,0">
            <Image Source="/Assets/logo.png" Width="52" Height="52" HorizontalAlignment="Left" />
            <TextBlock x:Name="StepTitle" Text="欢迎使用" FontSize="22" FontWeight="SemiBold"
                       Margin="0,14,0,0" />
            <TextBlock x:Name="StepSubtitle" Text="三步完成校园网自动拨号设置。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 内容 -->
        <StackPanel Grid.Row="1" Margin="28,16,28,8">

            <!-- Step 0 欢迎 -->
            <StackPanel x:Name="Panel0">
                <TextBlock Text="这个工具会帮你：" FontSize="15" Margin="0,4,0,8" />
                <BulletDecorator Margin="0,4"><BulletDecorator.Bullet><TextBlock Text="•  " /></BulletDecorator.Bullet>
                    <TextBlock Text="开机自动连接校园网，不用每次手动点宽带连接" TextWrapping="Wrap" /></BulletDecorator>
                <BulletDecorator Margin="0,8"><BulletDecorator.Bullet><TextBlock Text="•  " /></BulletDecorator.Bullet>
                    <TextBlock Text="息屏、休眠恢复后断线自动重拨" TextWrapping="Wrap" /></BulletDecorator>
                <BulletDecorator Margin="0,8"><BulletDecorator.Bullet><TextBlock Text="•  " /></BulletDecorator.Bullet>
                    <TextBlock Text="账号密码加密保存在本机，不上传任何数据" TextWrapping="Wrap" /></BulletDecorator>
                <TextBlock Text="前提：学校使用 PPPoE 拨号上网（不是网页认证）。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,18,0,0" FontSize="13" />
            </StackPanel>

            <!-- Step 1 选择连接 -->
            <StackPanel x:Name="Panel1" Visibility="Collapsed">
                <TextBlock Text="选择一个拨号连接：" FontSize="15" Margin="0,4,0,8" />
                <ComboBox x:Name="ConnectionCombo" HorizontalAlignment="Stretch" />
                <ui:Button Content="刷新列表" Appearance="Transparent" Margin="0,10,0,0"
                           HorizontalAlignment="Left" Click="OnRefresh">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                </ui:Button>

                <TextBlock Text="列表为空？输入名称创建一个标准 PPPoE 连接："
                           Margin="0,20,0,6" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NewConnectionBox" Grid.Column="0" PlaceholderText="例如：宽带连接" />
                    <ui:Button Grid.Column="1" Content="创建" Appearance="Secondary"
                               Margin="10,0,0,0" Click="OnCreate">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </StackPanel>

            <!-- Step 2 账号密码 -->
            <StackPanel x:Name="Panel2" Visibility="Collapsed">
                <TextBlock Text="输入校园网账号和密码：" FontSize="15" Margin="0,4,0,10" />
                <TextBlock Text="账号（通常是学号）" FontSize="13" />
                <ui:TextBox x:Name="UserBox" Margin="0,6,0,0" PlaceholderText="校园网账号" />
                <TextBlock Text="密码" FontSize="13" Margin="0,16,0,0" />
                <ui:PasswordBox x:Name="PassBox" Margin="0,6,0,0" PlaceholderText="校园网密码" />
            </StackPanel>

            <!-- Step 3 完成选项 -->
            <StackPanel x:Name="Panel3" Visibility="Collapsed">
                <TextBlock Text="推荐开启以下选项：" FontSize="15" Margin="0,4,0,10" />
                <ui:ToggleSwitch x:Name="EnableWatchdog" Content="开启断线自动重拨" IsChecked="True" Margin="0,6" />
                <ui:ToggleSwitch x:Name="EnableAutostart" Content="开机自动启动守护" IsChecked="True" Margin="0,6" />
                <ui:ToggleSwitch x:Name="TestNow" Content="完成后立即测试拨号" IsChecked="True" Margin="0,6" />
            </StackPanel>
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Margin="28,8,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BackButton" Grid.Column="1" Content="上一步" Appearance="Secondary"
                       Padding="20,8" Margin="0,0,10,0" Click="OnBack" />
            <ui:Button x:Name="NextButton" Grid.Column="2" Content="下一步" Appearance="Primary"
                       Padding="20,8" Click="OnNext" />
        </Grid>
    </Grid>
</ui:FluentWindow>
