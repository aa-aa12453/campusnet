<Page x:Class="CampusNet.Dialer.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="账号设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24" MaxWidth="680" HorizontalAlignment="Stretch">
            <TextBlock Text="账号设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="选择拨号连接，填写校园网账号和密码。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

            <ui:CardControl Margin="0,18,0,0" Padding="26,22">
                <StackPanel>
                    <!-- 拨号连接 -->
                    <TextBlock Text="拨号连接" FontSize="14" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ConnectionCombo" Grid.Column="0"
                                  HorizontalAlignment="Stretch" SelectionChanged="OnConnectionSelected" />
                        <ui:Button Grid.Column="1" Content="刷新" Appearance="Transparent"
                                   Margin="10,0,0,0" Click="OnRefresh" VerticalAlignment="Stretch">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <!-- 新建连接 -->
                    <TextBlock Text="没有可用连接？输入名称后创建一个标准 PPPoE 连接："
                               Margin="0,16,0,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="NewConnectionBox" Grid.Column="0"
                                    PlaceholderText="例如：宽带连接" />
                        <ui:Button Grid.Column="1" Content="创建" Appearance="Secondary"
                                   Margin="10,0,0,0" Click="OnCreateConnection">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Border Height="1" Margin="0,20,0,20"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 账号 -->
                    <TextBlock Text="校园网账号" FontSize="14" />
                    <ui:TextBox x:Name="UserBox" Margin="0,6,0,0"
                                PlaceholderText="通常是学号" />

                    <!-- 密码 -->
                    <TextBlock Text="密码" FontSize="14" Margin="0,16,0,0" />
                    <ui:PasswordBox x:Name="PassBox" Margin="0,6,0,0"
                                    PlaceholderText="校园网密码" />
                </StackPanel>
            </ui:CardControl>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <ui:Button Content="保存" Appearance="Primary" Padding="22,9" Click="OnSave">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="保存并测试拨号" Appearance="Secondary" Padding="22,9"
                           Margin="12,0,0,0" Click="OnSaveAndTest">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <ui:InfoBar x:Name="MessageBar" Margin="0,16,0,0" IsOpen="False"
                        IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
