<Page x:Class="CampusNet.Dialer.Pages.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="日志">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="运行日志" FontSize="26" FontWeight="SemiBold" />

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="KindCombo" Grid.Column="0" Width="120" SelectionChanged="OnKindChanged">
                <ComboBoxItem Content="拨号日志" IsSelected="True" />
                <ComboBoxItem Content="守护日志" />
            </ComboBox>

            <ComboBox x:Name="MonthCombo" Grid.Column="1" Width="130" Margin="10,0,0,0"
                      SelectionChanged="OnMonthChanged" />

            <ui:Button Grid.Column="3" Content="刷新" Appearance="Transparent" Click="OnRefresh">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button Grid.Column="4" Content="导出" Appearance="Transparent" Margin="10,0,0,0"
                       Click="OnExport">
                <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowExport24" /></ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- 日志内容 -->
        <ui:CardControl Grid.Row="2" Padding="0">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="13" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Margin="16,14" AcceptsReturn="True" />
        </ui:CardControl>
    </Grid>
</Page>
