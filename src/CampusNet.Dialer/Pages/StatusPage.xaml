<Page x:Class="CampusNet.Dialer.Pages.StatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="状态">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24" MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock Text="网络状态" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="查看当前校园网连接情况，可手动拨号或挂断。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

            <!-- 主状态卡片 -->
            <ui:CardControl Margin="0,18,0,0" Padding="30,26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="#FF8A8A8A" />
                        <TextBlock x:Name="StatusText" Text="正在检测…" FontSize="20" FontWeight="SemiBold"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,24,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="拨号连接" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                            <TextBlock x:Name="ConnectionNameText" Text="—" FontSize="16" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="IP 地址" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                            <TextBlock x:Name="IpAddressText" Text="—" FontSize="16" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <ui:Button x:Name="DialButton" Content="立即拨号" Appearance="Primary"
                                   Padding="22,9" Click="OnDialClick" VerticalAlignment="Center">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="PlugConnected24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="HangUpButton" Content="挂断" Appearance="Secondary"
                                   Padding="22,9" Margin="12,0,0,0" Click="OnHangUpClick"
                                   Visibility="Collapsed" VerticalAlignment="Center">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="PlugDisconnected24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:ProgressRing x:Name="BusyRing" Margin="16,0,0,0" Visibility="Collapsed"
                                         IsIndeterminate="True" Width="26" Height="26" />
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>

            <!-- 守护状态卡片 -->
            <ui:CardControl Margin="0,14,0,0" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="WatchdogDot" Width="11" Height="11" Fill="#FF8A8A8A" VerticalAlignment="Center" />
                            <TextBlock x:Name="WatchdogText" Text="自动重拨：未知" Margin="9,0,0,0"
                                       FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="WatchdogDetail" Margin="0,5,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="断线后将自动重连。" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="管理" Appearance="Transparent"
                               VerticalAlignment="Center" Click="OnGoWatchdog" />
                </Grid>
            </ui:CardControl>

            <ui:InfoBar x:Name="MessageBar" Margin="0,16,0,0" IsOpen="False"
                        Severity="Informational" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
